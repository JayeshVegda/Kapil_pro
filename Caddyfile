http://127.0.0.1:4174, http://localhost:4174, http://arch:4174, http://100.66.74.78:4174 {
	encode zstd gzip

	handle_path /pb/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# PaymentDesk Muse AI surface (key-authed inside PaymentDesk; loopback only)
	handle /muse/* {
		reverse_proxy 127.0.0.1:4782 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/market-rate {
		rewrite * /telegram/channel/brassb2b
		reverse_proxy http://127.0.0.1:4174/api/market-rate {
			header_up Host 127.0.0.1
		}
	}

	handle /assets/* {
		root * /home/arch/project/Kapil_pro/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /fonts/* {
		root * /home/arch/project/Kapil_pro/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * /home/arch/project/Kapil_pro/dist
		header Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Catch-all for any other hostname on this port (e.g. Tailscale MagicDNS name)
http://:4174 {
	encode zstd gzip

	handle_path /pb/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# PaymentDesk Muse AI surface (key-authed inside PaymentDesk; loopback only)
	handle /muse/* {
		reverse_proxy 127.0.0.1:4782 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/market-rate {
		rewrite * /telegram/channel/brassb2b
		reverse_proxy http://127.0.0.1:4174/api/market-rate {
			header_up Host 127.0.0.1
		}
	}

	handle {
		root * /home/arch/project/Kapil_pro/dist
		header Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
