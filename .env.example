# Kapil frontend build config.
# VITE_* values are bundled into the browser build, so keep secrets out of them.

# Use the exact PocketBase user email you want to log in with.
# Current imported database users include:
# - jay@kapil.cosearch.me
# - jayeshvegda198@gmail.com
VITE_LOGIN_EMAIL=jay@kapil.cosearch.me

# Production behind Caddy uses the same domain with /pb proxied to PocketBase.
VITE_POCKETBASE_URL=/pb

# Production market rate RSS proxy. Do not point the browser directly at RSSHub.
VITE_MARKET_RATE_URL=/api/market-rate

# Optional: only needed when running admin/import/maintenance scripts manually.
# These are server-side script credentials and must never be exposed as VITE_*.
PB_URL=http://127.0.0.1:8090
PB_ADMIN_EMAIL=
PB_ADMIN_PASSWORD=
PB_SUPERUSER_EMAIL=
PB_SUPERUSER_PASSWORD=

# Brass RSS watcher / Telegram reporting.
BRASS_RSS_URL=https://rss.zayu.dev/telegram/channel/brassb2b
BRASS_TELEGRAM_BOT_TOKEN=
BRASS_TELEGRAM_CHAT_ID=
BRASS_DAEMON_TZ=Asia/Kolkata
BRASS_DAEMON_WINDOW_START=10:20
BRASS_DAEMON_WINDOW_END=10:50
BRASS_DAEMON_ACTIVE_INTERVAL_SECONDS=120
BRASS_DAEMON_IDLE_INTERVAL_SECONDS=900
BRASS_DAEMON_REQUIRE_TODAY=true
# Falls back to TELEGRAM_BOT_TOKEN/TELEGRAM_CHAT_ID when BRASS_* values are blank.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Legacy interactive Telegram quick-access bot. Not used by the production
# brass-rate notifier container.
KAPIL_BOT_TOKEN=
KAPIL_BOT_ALLOWED_USER_IDS=
KAPIL_BOT_ALLOW_ALL_USERS=false
KAPIL_BOT_POLL_TIMEOUT_SECONDS=25

# Optional demo import tuning.
EXTRA_BILLS=220
EXTRA_PAYMENTS=320
BRASS_RATES_CSV=
