{
  "name": "billing-foundation-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:start": "docker start kapil-billing-pocketbase-local || docker run -d --name kapil-billing-pocketbase-local -p 8091:8090 -v \"$PWD/pb_data:/pb_data\" ghcr.io/muchobien/pocketbase:latest serve --http=0.0.0.0:8090 --dir=/pb_data",
    "db:logs": "docker logs --tail=100 kapil-billing-pocketbase-local",
    "router:generate": "npx --no-install @tanstack/router-cli generate",
    "typecheck": "npm run router:generate && tsc -b --pretty false",
    "build": "npm run router:generate && tsc -b && vite build",
    "test": "vitest run",
    "verify": "npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.4",
