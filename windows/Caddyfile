http://127.0.0.1:4174, http://localhost:4174, http://kapil-products:4174, http://100.75.200.72:4174 {
	encode zstd gzip

	handle_path /pb/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# PaymentDesk Muse AI surface (key-authed inside PaymentDesk; loopback only)
	handle /muse/* {
		reverse_proxy 127.0.0.1:4782 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/market-rate {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/runtime/data
		rewrite * /market-rate.xml
		header Content-Type "application/rss+xml; charset=utf-8"
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle /assets/* {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle /fonts/* {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/dist
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/dist
		header Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}

# Catch-all for any other hostname on this port (e.g. Tailscale MagicDNS name)
http://:4174 {
	encode zstd gzip

	handle_path /pb/* {
		reverse_proxy 127.0.0.1:8090 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	# PaymentDesk Muse AI surface (key-authed inside PaymentDesk; loopback only)
	handle /muse/* {
		reverse_proxy 127.0.0.1:4782 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote_host}
		}
	}

	handle /api/market-rate {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/runtime/data
		rewrite * /market-rate.xml
		header Content-Type "application/rss+xml; charset=utf-8"
		header Cache-Control "no-cache, no-store, must-revalidate"
		file_server
	}

	handle {
		root * C:/Site_imp/kapil-windows/JayeshVegda-Kapil_pro-49c561a/dist
		header Cache-Control "no-store, no-cache, must-revalidate"
		try_files {path} /index.html
		file_server
	}
}
