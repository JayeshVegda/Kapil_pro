{
  "name": "billing-foundation-tmp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "db:seed:large": "node scripts/seed-large-demo.mjs",
    "brass:watch": "node scripts/brass-rss-watch.mjs",
    "brass:test": "node scripts/brass-rss-watch.mjs --dry-run",
    "brass:test:today": "node scripts/brass-rss-watch.mjs --dry-run --require-today",
    "brass:daemon": "node scripts/brass-rss-daemon.mjs",
    "brass:backfill": "node scripts/brass-rss-watch.mjs --backfill --no-telegram",
    "brass:weekly": "node scripts/brass-weekly-report.mjs",
    "router:generate": "npx --no-install @tanstack/router-cli generate",
    "typecheck": "npm run router:generate && tsc -b --pretty false",
    "build": "npm run router:generate && tsc -b && vite build",
    "test": "vitest run",
    "smoke": "node scripts/smoke-ui.mjs",
    "smoke:interactions": "node scripts/smoke-ui-interactions.mjs",
    "verify": "npm run typecheck && npm run test && npm run build",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.2.8",
    "@hookform/resolvers": "^5.2.2",
    "@tailwindcss/vite": "^4.2.4",
    "@tanstack/query-async-storage-persister": "^5.102.5",
    "@tanstack/react-query": "^5.100.4",
    "@tanstack/react-query-persist-client": "^5.102.5",
    "@tanstack/react-router": "^1.168.24",
    "@tanstack/react-router-devtools": "^1.166.13",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "html-to-image": "^1.11.13",
    "html2canvas": "^1.4.1",
    "idb-keyval": "^6.3.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "jszip": "^3.10.1",
    "lucide-react": "^1.11.0",
    "next-themes": "^0.4.6",
    "playwright": "^1.60.0",
    "pocketbase": "^0.26.8",
    "radix-ui": "^1.4.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "react-hook-form": "^7.73.1",
    "recharts": "^3.10.1",
    "shadcn": "^4.5.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tanstack/router-cli": "^1.166.35",
    "@tanstack/router-plugin": "^1.167.26",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.2.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.5.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.2",
    "vite": "^8.0.10",
    "vitest": "^4.1.5"
  },
  "optionalDependencies": {
    "@rolldown/binding-linux-x64-gnu": "^1.0.0-rc.17"
  }
}
